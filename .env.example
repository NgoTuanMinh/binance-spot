# Telegram (bắt buộc)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Cặp giao dịch (Binance spot)
# Để trống = lấy top TOP_SYMBOLS_COUNT theo khối lượng 24h. Có giá trị = dùng list cố định
# SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
SYMBOLS=

# Số symbol lấy theo volume 24h (chỉ dùng khi SYMBOLS trống). Cho phép 10-100
TOP_SYMBOLS_COUNT=50

# Chu kỳ quét (giờ)
POLLING_INTERVAL_HOURS=4

# Lọc volume tối thiểu (USDT, 24h)
MIN_VOLUME_USDT=1000000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
