# Telegram (bắt buộc)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Cặp giao dịch (Binance spot)
# Để trống = lấy top TOP_SYMBOLS_COUNT theo khối lượng 24h. Có giá trị = dùng list cố định
# SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
SYMBOLS=

# Số symbol lấy theo volume 24h (chỉ dùng khi SYMBOLS trống). Cho phép 10-100
TOP_SYMBOLS_COUNT=50

# Chu kỳ quét (giờ) — nên để 1 vì bot dùng tín hiệu volume 1H
POLLING_INTERVAL_HOURS=1

# Số nến 1H đã đóng được xét cho volume spike (mặc định 2, tránh bỏ sót khi scan trễ vài phút)
VOLUME_SPIKE_LOOKBACK_CANDLES=2

# Lọc volume tối thiểu (USDT, 24h)
MIN_VOLUME_USDT=1000000

# Strategy params (aggressive profile ~905% backtest)
VOLUME_SPIKE_MIN_RATIO=0.5
ACCUMULATION_RANGE_MAX_PCT=60
ACCUMULATION_POSITION_PCT=30
BREAKOUT_THRESHOLD_PCT=90
ATR_SL_MULTIPLIER=0.35
RSI_MIN_DAILY=26
TP1_RR_RATIO=1.3
TP2_RR_RATIO=15.0

# Bộ lọc xu hướng BTC: bật (true) = chỉ scan altcoin khi BTC đang uptrend
ENABLE_BTC_FILTER=false

# Delay giữa mỗi symbol (giây) để tránh Binance rate limit
SCAN_DELAY_SECONDS=0.3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
